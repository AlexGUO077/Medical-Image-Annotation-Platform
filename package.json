{
  "name": "medical-image-annotation-platform",
  "private": true,
  "version": "0.0.0",
  "workspaces": ["server", "web-anno"],
  "engines": { "node": "20.20.2", "npm": ">=10 <12" },
  "overrides": { "multer": "2.4.0" },
  "devDependencies": { "js-yaml": "4.3.2" },
  "scripts": {
    "preinstall": "node scripts/runtime-version.mjs",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --test scripts/*.test.mjs && npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "check:forbidden-files": "node scripts/check-forbidden-files.mjs",
    "check": "npm run check:forbidden-files && npm run lint && npm run typecheck && npm test && npm run build"
  }
}
