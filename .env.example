# Synthetic local development only. Do not place real medical data in local volumes.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=miap
POSTGRES_DB=miap_synthetic
POSTGRES_PASSWORD=
SEED_ADMIN_PASSWORD=
JWT_SECRET=
# Independent signing key for five-minute frame tickets (at least 32 random bytes).
FRAME_TOKEN_SECRET=
MFA_ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:5173

ORTHANC_HOST=127.0.0.1
ORTHANC_PORT=8042
ORTHANC_USERNAME=
ORTHANC_PASSWORD=

MINIO_HOST=127.0.0.1
MINIO_PORT=9000
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_MASK_MAP_BUCKET=miap-mask-maps
MASK_MAP_ENCRYPTION_KEY=

# Local subprocess only; requires Python 3.11 and server/workers/requirements.txt.
DEID_WORKER_PYTHON=python3
DICOM_UID_SECRET=
IMPORT_QUARANTINE_DIR=/tmp/miap-import-quarantine

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

ELASTICSEARCH_HOST=127.0.0.1
ELASTICSEARCH_PORT=9200
ELASTIC_PASSWORD=
SEARCH_ELASTIC_USERNAME=miap_search
SEARCH_ELASTIC_PASSWORD=
