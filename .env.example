# Explicit deployment policy; no default quotas. CT/MR must exceed CR/DX.
FRAME_RATE_WINDOW_SECONDS=
FRAME_RATE_CR=
FRAME_RATE_DX=
FRAME_RATE_CT=
FRAME_RATE_MR=
FRAME_RATE_US=
