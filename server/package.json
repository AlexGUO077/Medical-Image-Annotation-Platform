{
  "name": "@miap/server",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "start:dev": "nest start --watch",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "nest build",
    "migration:show": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:show",
    "migration:run": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:run",
    "migration:revert": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:revert",
    "db:seed": "ts-node src/database/seed.ts",
    "db:provision-role": "ts-node src/database/provision-role.ts",
    "db:verify": "ts-node src/database/verify.ts",
    "db:verify-cycle": "ts-node src/database/verify-cycle.ts",
    "auth:reset-mfa": "ts-node src/modules/users/reset-admin-mfa.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.5",
    "@nestjs/core": "11.2.5",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/platform-express": "11.2.5",
    "dotenv": "18.0.1",
    "otplib": "13.5.0",
    "pg": "8.23.0",
    "qrcode": "1.5.4",
    "redis": "6.2.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.3",
    "@nestjs/testing": "12.0.3",
    "@types/node": "26.6.1",
    "@types/qrcode": "1.5.6",
    "ts-node": "10.9.2",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
